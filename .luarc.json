{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime.version": "Lua 5.4",
  "workspace.library": [
    ".envy/cache/envy/0.4.4",
    "~/Library/Caches/envy/envy/0.4.4",
    "~/.cache/envy/envy/0.4.4",
    "${env:USERPROFILE}/AppData/Local/envy/envy/0.4.4"
  ],
  "diagnostics.globals": [
    "envy", "IDENTITY", "PACKAGES", "DEPENDENCIES", "PRODUCTS",
    "FETCH", "STAGE", "BUILD", "INSTALL", "SETUP", "ENVY_IMPORTER"
  ],
  "completion.enable": true
}
